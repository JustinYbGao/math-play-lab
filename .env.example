# Configure locally. Never put an API key in the browser, source control, or chat.
# With no MODEL_PROVIDER, OpenRouter is selected when OPENROUTER_API_KEY is present;
# otherwise the server keeps the OpenAI provider behavior.
MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v3.2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional backward-compatible OpenAI Responses API configuration.
# MODEL_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Development uses installed Google Chrome on macOS by default.
# BROWSER_EXECUTABLE=/path/to/chrome
PORT=4318

# Demo generation safety. Development has no global request cap by default.
APP_MODE=development
GENERATION_ENABLED=true
# For a public-mode deployment, set a positive integer, for example:
# APP_MODE=public
# DEMO_MAX_GENERATIONS=100
# DEMO_BUDGET_FILE=.data/generation-budget.json
