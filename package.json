{
  "name": "math-play-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.20.0" },
  "dependencies": { "playwright-core": "1.62.1" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "eval": "node --env-file-if-exists=.env evaluation/run.mjs",
    "eval:report": "node evaluation/report.mjs",
    "eval:validate": "node evaluation/validate.mjs",
    "test": "node --test tests/*.test.mjs"
  }
}
